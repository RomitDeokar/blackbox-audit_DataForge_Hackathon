# Copy to .env and fill in. NEVER commit .env.
# The offline harness, the dashboard and the whole test suite need NONE of these.
# Only the live LiveKit agents (naive_agent / fenced_agent) and scripts/test_rime.py do.

# --- LiveKit (live voice sessions only) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Model providers ---
RIME_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# --- Optional overrides (defaults shown) ---
# STT_MODEL=nova-3
# LLM_MODEL=gpt-4o-mini
# RIME_MODEL=mistv2
# RIME_SPEAKER=astra
# GATING_WORD=confirmed

# --- Storage ---
DB_PATH=./results/booking.db
