# BlackBox Audit — environment template. Copy to .env and fill in.
# NEVER commit a real .env. NEVER paste real keys into a coding-agent prompt.

# --- LiveKit ---
# For the MOBILE demo this MUST be a LiveKit Cloud wss:// URL.
# http:// or a LAN IP (192.168.x.x / localhost) = phone cannot connect and/or
# the browser refuses microphone access. See docs/MOBILE_SETUP.md.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Voice stack ---
# Rime covers TTS only. STT and LLM are separate providers and env-var driven.
RIME_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# --- Models (defaults match the verified setup; override only deliberately) ---
STT_MODEL=nova-3
LLM_MODEL=gpt-4o-mini
RIME_MODEL=mistv2
RIME_SPEAKER=astra

# --- Fence ---
# The single word whose completed playback authorises the DB commit.
GATING_WORD=confirmed

# --- Storage ---
DB_PATH=./results/booking.db
